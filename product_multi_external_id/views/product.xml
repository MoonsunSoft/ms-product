<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_template_only_form_view_inherit_ext_idee" model="ir.ui.view">
        <field name="name">product.template.only.form.view.inherit.ext.idee</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_external_ids" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                    View External Ids
                </button>
            </xpath>
            
            
        </field>
    </record>

    <record id="product_normal_form_view_inherit_ext_idee" model="ir.ui.view">
        <field name="name">product.normal.form.view.inherit.ext.idee</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('oe_button_box')]" position="inside">
                <button name="action_view_external_ids" type="object" class="oe_stat_button" icon="fa-pencil-square-o">
                    View External Ids
                </button>
            </xpath>
        </field>
    </record>
</odoo>
