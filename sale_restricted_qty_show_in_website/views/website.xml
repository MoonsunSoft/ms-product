<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="template_show_qty_min_max" name="Show Min AND Max" customize_show="True"
        active="True" inherit_id="website_sale.product">
        <xpath expr="//t[@t-placeholder='select']" position="before">
            <div class="p-1 m-1">
                <span t-if="product.sale_min_qty != 0"> Min Qty : <t t-out="product.sale_min_qty" />
                </span>
                <br t-if="product.sale_min_qty != 0" />
                <span t-if="product.sale_max_qty != 0"> Max Qty : <t t-out="product.sale_max_qty" />
                </span>
                <br t-if="product.sale_max_qty != 0" />
            </div>
        </xpath>
    </template>
</odoo>