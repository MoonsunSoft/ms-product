<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_sale_form_view" model="ir.ui.view">
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view" />
        <field name="arch" type="xml">
            <xpath expr="//page[@name='sales']" position="after">
                <page name="salelist" string="Sale List">
                    <field name="sale_order_product_template_line_ids"
                        domain="[('product_template_id','=',self.id)]">
                        <tree string="Sale Order Lines" create="false">
                            <field name="order_date" widget="date" optional="show"/>
                            <field name="order_id" optional="show"/>
                            <field name="order_partner_id" optional="show"/>
                            <field name="name" optional="show"/>
                            <field name="salesman_id" optional="show"/>
                            <field name="product_uom_qty" string="Qty" optional="show"/>
                            <field name="qty_delivered" optional="show"/>
                            <field name="qty_invoiced" optional="show"/>
                            <field name="qty_to_invoice" optional="show"/>
                            <field name="product_uom" string="Unit of Measure"
                                groups="uom.group_uom" optional="show"/>
                            <field name="price_subtotal" sum="Total" widget="monetary" optional="show"/>
                            <field name="price_unit" optional="show"/>
                            <field name="currency_id" column_invisible="True" optional="show"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>